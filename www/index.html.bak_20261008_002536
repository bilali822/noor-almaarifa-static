<script>
    // CSRF wrapper
    (function(){
        const nativeFetch = window.fetch.bind(window);
        function csrfCookie(){
            const m = document.cookie.match(/(?:^|; )csrf_token=([^;]+)/);
            return m ? decodeURIComponent(m[1]) : '';
        }
        window.fetch = function(input, init){
            init = init || {};
            const method = String(init.method || 'GET').toUpperCase();
            if (['POST','PUT','PATCH','DELETE'].includes(method)) {
                const headers = new Headers(init.headers || {});
                const token = csrfCookie();
                if (token) headers.set('X-CSRF-Token', token);
                headers.set('Accept', 'application/json');
                init.headers = headers;
                init.credentials = 'include';
            }
            return nativeFetch(input, init);
        };
    })();
    
    function toggleTheme() {
        var body = document.body;
        var btn = document.getElementById('themeBtn');
        body.classList.toggle('dark-mode');
        btn.textContent = body.classList.contains('dark-mode') ? '☀️' : '🌙';
        localStorage.setItem('theme', body.classList.contains('dark-mode') ? 'dark' : 'light');
    }
    
    function loadTheme() {
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-mode');
            document.getElementById('themeBtn').textContent = '☀️';
        }
    }
    
    function createParticles() {
    // ⚡ معطّل على الأجهزة الضعيفة
    if (window.matchMedia("(max-width: 1024px)").matches) return;
    if (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4) return;
}
    }
    
    function createRipple(e) {
        var card = e.currentTarget;
        var ripple = document.createElement('span');
        ripple.className = 'ripple';
        var rect = card.getBoundingClientRect();
        var size = Math.max(rect.width, rect.height);
        ripple.style.width = ripple.style.height = size + 'px';
        ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
        ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
        card.appendChild(ripple);
        setTimeout(function() { ripple.remove(); }, 600);
    }
    
    function trackMouse(e) {
        document.querySelectorAll('.card').forEach(function(card) {
            var rect = card.getBoundingClientRect();
            card.style.setProperty('--x', ((e.clientX - rect.left) / rect.width) * 100 + '%');
            card.style.setProperty('--y', ((e.clientY - rect.top) / rect.height) * 100 + '%');
        });
    }
    
    function toggleDevModal() {
        document.getElementById('devModal').classList.toggle('active');
    }
    
    function copyEmail() {
        var email = 'bilalimhamad051@gmail.com';
        navigator.clipboard.writeText(email);
        showToast('📧 تم نسخ البريد الإلكتروني: ' + email);
    }
    
    function copyWhatsApp() {
        var whatsapp = '+96181274729';
        navigator.clipboard.writeText(whatsapp);
        showToast('💬 تم نسخ رقم واتساب: ' + whatsapp);
    }
    
    // ✅ دالة toast أنيقة بدلاً من alert
    function showToast(msg) {
        var old = document.querySelector('.nm-toast');
        if (old) old.remove();
        var toast = document.createElement('div');
        toast.className = 'nm-toast';
        toast.style.cssText = 'position:fixed;bottom:30px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,#6C63FF,#5A4FCF);color:white;padding:14px 28px;border-radius:14px;font-weight:700;font-size:15px;box-shadow:0 10px 40px rgba(108,99,255,.4);z-index:99999;font-family:Tajawal,sans-serif;';
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(function(){ toast.style.transition='all .3s'; toast.style.opacity='0'; setTimeout(function(){toast.remove();},300); }, 2000);
    }
    
    // ✅ دالة showFeature للبطاقات
    
    
    document.addEventListener('click', function(e) {
