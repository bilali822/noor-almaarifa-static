<script>
(function() {
  'use strict';
  
  // ═══════════════════════════════════════════════════
  // المحتوى الديني
  // ═══════════════════════════════════════════════════
  const content = [
    {
      icon: '📖',
      text: '﴿ إِنَّ هَذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ ﴾',
      source: 'الإسراء: 9'
    },
    {
      icon: '🌙',
      text: '"خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ"',
      source: 'رواه البخاري'
    },
    {
      icon: '✨',
      text: '﴿ وَنُنَزِّلُ مِنَ الْقُرْآنِ مَا هُوَ شِفَاءٌ وَرَحْمَةٌ لِلْمُؤْمِنِينَ ﴾',
      source: 'الإسراء: 82'
    },
    {
      icon: '💫',
      text: '"مَنْ قَرَأَ حَرْفًا مِنْ كِتَابِ اللهِ فَلَهُ بِهِ حَسَنَةٌ"',
      source: 'رواه الترمذي'
    },
    {
      icon: '🕌',
      text: '﴿ إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ ﴾',
      source: 'الحجر: 9'
    },
    {
      icon: '🌸',
      text: '"اقْرَؤُوا الْقُرْآنَ فَإِنَّهُ يَأْتِي يَوْمَ الْقِيَامَةِ شَفِيعًا لِأَصْحَابِهِ"',
      source: 'رواه مسلم'
    },
    {
      icon: '🌿',
      text: '﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾',
      source: 'الرعد: 28'
    },
    {
      icon: '⭐',
      text: '"الدَّالُّ عَلَى الْخَيْرِ كَفَاعِلِهِ"',
      source: 'رواه الترمذي'
    },
    {
      icon: '📿',
      text: '﴿ وَقُلْ رَبِّ زِدْنِي عِلْمًا ﴾',
      source: 'طه: 114'
    },
    {
      icon: '🌅',
      text: '"مَنْ سَلَكَ طَرِيقًا يَطْلُبُ فِيهِ عِلْمًا سَلَكَ اللهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ"',
      source: 'رواه مسلم'
    }
  ];
  
  // رسائل حالة
  const statusMessages = [
    'جاري تجهيز التطبيق...',
    'تحميل بيانات القرآن...',
    'تجهيز التفاسير...',
    'التحضير شبه جاهز...',
    'لحظات من فضلك...',
    'قد يستغرق بعض الوقت...',
    'جاري الاتصال بالخادم...'
  ];
  
  let contentIndex = 0;
  let statusIndex = 0;
  let progress = 0;
  
  const iconEl = document.getElementById('nmSplashIcon');
  const textEl = document.getElementById('nmSplashText');
  const sourceEl = document.getElementById('nmSplashSource');
  const statusEl = document.getElementById('nmSplashStatus');
  const barEl = document.getElementById('nmSplashBar');
  const skipBtn = document.getElementById('nmSplashSkip');
  
  // ═══════════════════════════════════════════════════
  // تغيير المحتوى
  // ═══════════════════════════════════════════════════
  function changeContent() {
    if (textEl) textEl.classList.add('nm-splash-fade');
    if (sourceEl) sourceEl.classList.add('nm-splash-fade');
    
    setTimeout(() => {
      contentIndex = (contentIndex + 1) % content.length;
      const item = content[contentIndex];
      
      if (iconEl) iconEl.textContent = item.icon;
      if (textEl) textEl.textContent = item.text;
      if (sourceEl) sourceEl.textContent = item.source;
      
      if (textEl) textEl.classList.remove('nm-splash-fade');
      if (sourceEl) sourceEl.classList.remove('nm-splash-fade');
    }, 400);
  }
  
  // ═══════════════════════════════════════════════════
  // تغيير الحالة
  // ═══════════════════════════════════════════════════
  function changeStatus() {
    statusIndex = (statusIndex + 1) % statusMessages.length;
    if (statusEl) statusEl.textContent = statusMessages[statusIndex];
  }
  
  // ═══════════════════════════════════════════════════
  // زيادة التقدم
  // ═══════════════════════════════════════════════════
  function incrementProgress() {
    if (progress < 90) {
      progress += Math.random() * 5 + 2;
      if (progress > 90) progress = 90;
      if (barEl) barEl.style.width = progress + '%';
    }
  }
  
  // ═══════════════════════════════════════════════════
  // إخفاء الـ Splash
  // ═══════════════════════════════════════════════════
  function hideSplash() {
    const splash = document.getElementById('nmSplash');
    if (!splash) return;
    
    progress = 100;
    if (barEl) barEl.style.width = '100%';
    if (statusEl) statusEl.textContent = '✅ جاهز!';
    if (textEl) textEl.textContent = 'بارك الله فيك، تفضّل 🌙';
    if (sourceEl) sourceEl.textContent = '';
    
    setTimeout(() => {
      splash.classList.add('nm-splash-hide');
      setTimeout(() => splash.remove(), 800);
    }, 800);
  }
  
  // ═══════════════════════════════════════════════════
  // التشغيل
  // ═══════════════════════════════════════════════════
  
  // المحتوى الأول
  const first = content[0];
  if (iconEl) iconEl.textContent = first.icon;
  if (textEl) textEl.textContent = first.text;
  if (sourceEl) sourceEl.textContent = first.source;
  
  // تغيير المحتوى كل 4.5 ثوانٍ
  const contentTimer = setInterval(changeContent, 4500);
  
  // تغيير الحالة كل 2.5 ثانية
  const statusTimer = setInterval(changeStatus, 2500);
  
  // زيادة التقدم
  const progressTimer = setInterval(incrementProgress, 500);
  
  // اخفاء تلقائي عند تحميل الموقع
  function tryHide() {
    if (document.readyState === 'complete') {
      setTimeout(hideSplash, 1000);
    }
  }
  
  if (document.readyState === 'complete') {
    tryHide();
  } else {
    window.addEventListener('load', () => setTimeout(hideSplash, 1000));
  }
  
  // احتياطي — بعد 20 ثانية
  setTimeout(hideSplash, 20000);
  
  // زر التخطي
  if (skipBtn) {
    skipBtn.onclick = () => {
      clearInterval(contentTimer);
      clearInterval(statusTimer);
      clearInterval(progressTimer);
      hideSplash();
    };
  }
  
  console.log('[Splash] ✅ جاهز — محتوى ديني');
})();
</script>


