    try { localStorage.setItem('lastRead', JSON.stringify(v)); } catch(e){}
    currentVerseInfo = {surah_name: v.surah_name, surah_id: v.surah_id, verse_number: v.verse_number, verse_text: v.verse_text};
    addMessage('📖 سورة ' + v.surah_name + ' — الآية ' + v.verse_number + '\n\n﴿ ' + v.verse_text + ' ﴾', 'ai');
    fetch('/api/tafsir/books').then(function(r){ return r.json(); }).then(function(d){ openPopup(currentVerseInfo, d.books || []); }).catch(function(){});
}

function saveCurrentVerse() {
    if (!currentVerseInfo) return;
    var arr = [];
    try { arr = JSON.parse(localStorage.getItem('quranFavorites') || '[]'); } catch(e){}
    var item = {surah_id: currentVerseInfo.surah_id, surah_name: currentVerseInfo.surah_name, verse_number: currentVerseInfo.verse_number, verse_text: currentVerseInfo.verse_text};
    var exists = arr.some(function(x){ return x.surah_id === item.surah_id && x.verse_number === item.verse_number; });
    if (!exists) {
        arr.unshift(item);
        arr = arr.slice(0, 100);
        try { localStorage.setItem('quranFavorites', JSON.stringify(arr)); } catch(e){}
        alert('⭐ تم حفظ الآية');
    } else {
        alert('⭐ محفوظة مسبقاً');
    }
}

function openFavorites() {
    var list = document.getElementById('favoritesList');
    if (!list) return;
    var arr = [];
    try { arr = JSON.parse(localStorage.getItem('quranFavorites') || '[]'); } catch(e){}
    if (arr.length === 0) {
        list.innerHTML = '<p>لا توجد آيات محفوظة.</p>';
    } else {
        list.innerHTML = arr.map(function(v, i){
            return '<div style="padding:16px;border:1px solid var(--border-color);border-radius:16px;background:var(--bg-input);margin-bottom:9px;"><strong style="display:block;margin-bottom:7px;color:var(--primary);">📖 سورة ' + v.surah_name + ' — ' + v.verse_number + '</strong><div style="line-height:2;font-size:15px;">﴿ ' + v.verse_text + ' ﴾</div><button onclick="openFavorite(' + i + ')" style="margin-top:10px;margin-left:6px;border:1px solid var(--border-color);background:rgba(108,99,255,.08);color:var(--text-primary);border-radius:10px;padding:7px 12px;cursor:pointer;">عرض</button><button onclick="removeFavorite(' + i + ')" style="margin-top:10px;margin-left:6px;border:1px solid var(--border-color);background:rgba(108,99,255,.08);color:var(--text-primary);border-radius:10px;padding:7px 12px;cursor:pointer;">حذف</button></div>';
        }).join('');
    }
    var overlay = document.getElementById('favoritesOverlay');
    if (overlay) overlay.classList.add('active');
}

function openFavorite(i) {
    var arr = [];
    try { arr = JSON.parse(localStorage.getItem('quranFavorites') || '[]'); } catch(e){}
    var v = arr[i];
    if (!v) return;
    var overlay = document.getElementById('favoritesOverlay');
    if (overlay) overlay.classList.remove('active');
    showVerseFeature(v);
}

function removeFavorite(i) {
    var arr = [];
    try { arr = JSON.parse(localStorage.getItem('quranFavorites') || '[]'); } catch(e){}
    arr.splice(i, 1);
    try { localStorage.setItem('quranFavorites', JSON.stringify(arr)); } catch(e){}
    openFavorites();
}

function resumeLastRead() {
    var v = null;
    try { v = JSON.parse(localStorage.getItem('lastRead') || 'null'); } catch(e){}
    if (v) showVerseFeature(v);
    else alert('ℹ️ لا توجد قراءة سابقة');
}

function changeFontSize(dir) {
    document.body.classList.remove('font-large', 'font-xl');
    var n = parseInt(localStorage.getItem('quranFont') || '0') + dir;
    n = Math.max(0, Math.min(2, n));
    if (n === 1) document.body.classList.add('font-large');
    if (n === 2) document.body.classList.add('font-xl');
    try { localStorage.setItem('quranFont', String(n)); } catch(e){}
}

function loadFontSize() {
    var n = parseInt(localStorage.getItem('quranFont') || '0');
    if (n === 1) document.body.classList.add('font-large');
    if (n === 2) document.body.classList.add('font-xl');
}

async function copyCurrentVerse() {
    if (!currentVerseInfo) return;
    try {
        await navigator.clipboard.writeText('سورة ' + currentVerseInfo.surah_name + ' — الآية ' + currentVerseInfo.verse_number + '\n﴿ ' + currentVerseInfo.verse_text + ' ﴾');
        alert('📋 تم النسخ');
    } catch(e) { alert('❌ تعذر النسخ'); }
}

async function shareCurrentVerse() {
    if (!currentVerseInfo) return;
    var text = 'سورة ' + currentVerseInfo.surah_name + ' — الآية ' + currentVerseInfo.verse_number + '\n﴿ ' + currentVerseInfo.verse_text + ' ﴾';
    try {
        if (navigator.share) await navigator.share({title: 'آية', text: text});
        else { await navigator.clipboard.writeText(text); alert('📋 تم نسخ النص'); }
    } catch(e){}
}

function showCurrentSurah() {
    if (!currentVerseInfo) return;
    var name = currentVerseInfo.surah_name;
    closePopup();
    var inp = document.getElementById('input');
    if (inp) inp.value = name;
    sendMessage();
}

async function showSurahStats() {
    if (!currentVerseInfo) return;
    try {
        var r = await fetch('/api/surah/' + currentVerseInfo.surah_id + '/stats');
        var d = await r.json();
        if (!d.success) throw new Error(d.error);
        var el = document.getElementById('statsContent');
        if (el) el.innerHTML = '<h3>سورة ' + d.surah_name + '</h3><p>🔢 رقم: ' + d.surah_id + '</p><p>📖 عدد الآيات: ' + d.verses_count + '</p>';
        var overlay = document.getElementById('statsOverlay');
        if (overlay) overlay.classList.add('active');
    } catch(e) { alert('❌ تعذر التحميل'); }
}

async function navigateVerse(delta) {
    if (!currentVerseInfo) return;
    var n = Number(currentVerseInfo.verse_number) + delta;
    try {
        var r = await fetch('/api/verse/' + currentVerseInfo.surah_id + '/' + n);
        var d = await r.json();
        if (!d.success) { alert(delta < 0 ? 'هذه أول آية' : 'هذه آخر آية'); return; }
        showVerseFeature(d.verse);
    } catch(e) { alert('❌ تعذر الانتقال'); }
}

function toggleReadingMode() {
    document.body.classList.toggle('reading-mode');
    try { localStorage.setItem('readingMode', document.body.classList.contains('reading-mode') ? '1' : '0'); } catch(e){}
}

async function openTafsirLibrary() {
    var overlay = document.getElementById('booksOverlay');
    if (overlay) overlay.classList.add('active');
    var grid = document.getElementById('booksGrid');
    if (!grid || grid.dataset.loaded === '1') return;
    try {
        var r = await fetch('/api/tafsir/books');
        var d = await r.json();
        var books = d.books || [];
        if (books.length === 0) { grid.innerHTML = '<p>لا توجد كتب.</p>'; return; }
        grid.innerHTML = books.map(function(b){
            return '<div style="padding:16px;border:1px solid var(--border-color);border-radius:16px;background:var(--bg-input);"><strong>' + (b.icon || '📖') + ' ' + (b.name || b.short_name || 'تفسير') + '</strong><p style="color:var(--text-secondary);font-size:11px;line-height:1.7;margin:0;">' + (b.desc || '') + '</p></div>';
        }).join('');
        grid.dataset.loaded = '1';
    } catch(e) { grid.innerHTML = '<p>❌ تعذر التحميل</p>'; }
}

function clearChat() {
    if (!confirm('مسح المحادثة؟')) return;
    location.reload();
}

// ---------- التشغيل ----------
document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('input');
    var sendBtn = document.getElementById('sendBtn');
    loadTheme();
    loadFontSize();
    try { if (localStorage.getItem('readingMode') === '1') document.body.classList.add('reading-mode'); } catch(e){}
    
    if (sendBtn) sendBtn.addEventListener('click', sendMessage);
    if (input) {
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
        input.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 130) + 'px';
        });
        input.focus();
    }
    
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closePopup();
            var overlay = document.getElementById('featuresModalOverlay');
            if (overlay && overlay.classList.contains('active')) {
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        }
    });
});

