<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>القرآن الكريم - نور المعرفة</title>
     <!-- خط محلي (بدون إنترنت) -->
<style>
@font-face {
    font-family: 'Tajawal';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('./fonts/Tajawal-Regular.woff2') format('woff2');
}
@font-face {
    font-family: 'Tajawal';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('./fonts/Tajawal-Bold.woff2') format('woff2');
}
@font-face {
    font-family: 'Tajawal';
    font-style: normal;
    font-weight: 800;
    font-display: swap;
    src: url('./fonts/Tajawal-ExtraBold.woff2') format('woff2');
}
@font-face {
    font-family: 'Tajawal';
    font-style: normal;
    font-weight: 900;
    font-display: swap;
    src: url('./fonts/Tajawal-Black.woff2') format('woff2');
}
</style>

<!-- PWA Manifest -->
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#6C63FF">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="نور المعرفة">
<link rel="apple-touch-icon" href="./icons/icon-192.png">
    <style>
        :root{--primary:#6C63FF;--primary-dark:#5A4FCF;--primary-light:#8B83FF;--primary-glow:rgba(108,99,255,.3);--bg-body:#f0f2f8;--bg-header:rgba(255,255,255,.85);--bg-chat:rgba(255,255,255,.7);--bg-message-user:linear-gradient(135deg,#6C63FF,#5A4FCF);--bg-message-ai:rgba(255,255,255,.9);--text-primary:#1a1a2e;--text-secondary:#6B6B8A;--text-muted:#999;--shadow:0 8px 32px rgba(0,0,0,.08);--shadow-hover:0 16px 48px rgba(108,99,255,.15);--border-color:rgba(108,99,255,.12);--radius:20px;--transition:.4s cubic-bezier(.34,1.56,.64,1);--bg-input:rgba(255,255,255,.8)}
        body.dark-mode{--bg-body:#0a0a1a;--bg-header:rgba(21,21,47,.9);--bg-chat:rgba(21,21,47,.7);--bg-message-ai:rgba(30,30,60,.9);--text-primary:#EEEEFF;--text-secondary:#A8A8C8;--text-muted:#777;--shadow:0 8px 32px rgba(0,0,0,.4);--border-color:rgba(45,45,74,.5);--bg-input:rgba(30,30,60,.8)}
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Tajawal',sans-serif;background:var(--bg-body);color:var(--text-primary);height:100vh;display:flex;flex-direction:column;padding:16px;overflow:hidden;transition:all var(--transition)}
        .bg-animation{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
        .bg-animation .orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.15;animation:orbFloat 20s infinite alternate ease-in-out}
        .bg-animation .orb:nth-child(1){width:400px;height:400px;top:-100px;right:-100px;background:#6C63FF;animation-duration:25s}
        .bg-animation .orb:nth-child(2){width:300px;height:300px;bottom:-80px;left:-80px;background:#FF6B6B;animation-duration:20s;animation-delay:-5s}
        .bg-animation .orb:nth-child(3){width:250px;height:250px;top:50%;left:50%;transform:translate(-50%,-50%);background:#00D2FF;animation-duration:30s;animation-delay:-10s}
        @keyframes orbFloat{0%{transform:translate(0,0) scale(1)}33%{transform:translate(60px,-40px) scale(1.1)}66%{transform:translate(-40px,60px) scale(.9)}100%{transform:translate(30px,-30px) scale(1.05)}}
        .header{position:relative;z-index:1;background:var(--bg-header);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:12px 24px;border-radius:var(--radius);display:flex;justify-content:space-between;align-items:center;border:1px solid var(--border-color);box-shadow:var(--shadow);flex-shrink:0;min-height:68px}
        .header .brand{display:flex;align-items:center;gap:14px;flex:0 0 auto}
        .header .brand .back-btn{background:rgba(108,99,255,.1);border:1px solid var(--border-color);width:42px;height:42px;border-radius:50%;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-primary);transition:all var(--transition)}
        .header .brand .back-btn:hover{background:var(--primary);color:#fff;transform:rotate(180deg) scale(1.05);box-shadow:0 4px 20px var(--primary-glow)}
        .header .brand .icon-wrapper{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;font-size:22px;color:#fff;box-shadow:0 4px 20px var(--primary-glow);animation:iconPulse 3s infinite}
        @keyframes iconPulse{0%,100%{box-shadow:0 4px 20px var(--primary-glow)}50%{box-shadow:0 4px 40px rgba(108,99,255,.5)}}
        .header .brand .info h2{font-size:20px;font-weight:800;background:linear-gradient(135deg,var(--primary),var(--primary-light));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
        .header .brand .info span{font-size:11px;color:var(--text-secondary);display:block}
        .header-actions{display:flex;gap:12px;align-items:center;justify-content:center;flex:1;margin:0 10px}
        .header-actions .theme-toggle{background:rgba(108,99,255,.08);border:1px solid var(--border-color);width:42px;height:42px;border-radius:50%;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-primary);transition:all var(--transition)}
        .header-actions .theme-toggle:hover{background:var(--primary);color:#fff;transform:scale(1.08);box-shadow:0 4px 20px var(--primary-glow)}
        .btn-features-premium{position:relative;background:rgba(108,99,255,.08);color:var(--primary);border:1px solid var(--border-color);border-radius:12px;padding:10px 24px;font-size:15px;font-weight:700;cursor:pointer;font-family:'Tajawal',sans-serif;display:flex;align-items:center;gap:10px;min-height:42px;justify-content:center;letter-spacing:.3px;transition:all var(--transition)}
        .btn-features-premium:hover{background:var(--primary);color:#fff;transform:translateY(-2px);box-shadow:0 4px 25px var(--primary-glow);border-color:var(--primary)}
        .btn-features-premium:active{transform:scale(.96)}
        .btn-features-premium .premium-icon{font-size:18px;display:inline-block}
        .btn-features-premium .premium-badge{background:#FF6B6B;color:#fff;font-size:9px;font-weight:900;padding:1px 8px;border-radius:0;margin-right:2px}
        .btn-features-premium .premium-text{display:flex;align-items:center;gap:6px;font-size:15px}
        body.dark-mode .btn-features-premium{background:rgba(108,99,255,.12);color:var(--primary-light)}
        body.dark-mode .btn-features-premium:hover{background:var(--primary);color:#fff}
        .chat-wrapper{position:relative;z-index:1;flex:1;background:var(--bg-chat);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-radius:var(--radius);display:flex;flex-direction:column;overflow:hidden;margin-top:16px;border:1px solid var(--border-color);box-shadow:var(--shadow);height:calc(100vh - 92px);min-height:680px}
        .messages{flex:1;overflow-y:auto;padding:24px 28px;display:flex;flex-direction:column;gap:12px;min-height:0}
        .messages::-webkit-scrollbar{width:5px}
        .messages::-webkit-scrollbar-track{background:transparent}
        .messages::-webkit-scrollbar-thumb{background:var(--primary);border-radius:10px}
        .welcome{text-align:center;padding:10px 10px 20px;animation:fadeInUp .8s ease}
        @keyframes fadeInUp{from{opacity:0;transform:translateY(30px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
        .welcome .main-icon{font-size:64px;display:block;margin-bottom:12px;animation:floatIcon 4s infinite ease-in-out}
        @keyframes floatIcon{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-12px) rotate(3deg)}}
        .welcome h2{font-size:28px;font-weight:900;background:linear-gradient(135deg,var(--primary),#FF6B6B);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:6px 0}
        .welcome p{color:var(--text-secondary);font-size:16px;line-height:1.8}
        .welcome p strong{color:var(--primary)}
        .usage-box{background:rgba(108,99,255,.06);border-radius:18px;padding:20px 24px;margin:16px 0 20px;text-align:right;border:1px solid var(--border-color)}
        .usage-title{font-weight:700;font-size:17px;color:var(--text-primary);margin-bottom:12px;display:flex;align-items:center;gap:10px;justify-content:center}
        .usage-section{margin:6px 0}
        .usage-label{font-weight:600;font-size:14px;color:var(--primary);margin-bottom:4px;display:flex;align-items:center;gap:6px}
        .usage-item{font-size:13px;color:var(--text-secondary);padding:2px 18px 2px 0;position:relative}
        .usage-item::before{content:"✦";color:var(--primary);position:absolute;right:0;font-size:10px}
        .tafsir-list-welcome{margin:14px 0 18px}
        .tafsir-books-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
        .tafsir-book-card{background:rgba(255,255,255,.05);border-radius:16px;overflow:hidden;border:1px solid var(--border-color);transition:all var(--transition)}
        .tafsir-book-card:hover{transform:translateY(-4px);border-color:var(--primary);box-shadow:0 8px 30px rgba(0,0,0,.1)}
        .tafsir-book-header{padding:10px 16px;display:flex;align-items:center;gap:10px}
        .tafsir-book-header .icon{font-size:18px}
        .tafsir-book-header .name{font-weight:700;font-size:14px;color:#fff}
        .tafsir-book-desc{padding:10px 16px 14px;font-size:12px;color:var(--text-secondary);line-height:1.7;background:rgba(0,0,0,.05)}
        body.dark-mode .tafsir-book-desc{background:rgba(0,0,0,.2)}
        .examples{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:16px}
        .examples button{background:rgba(108,99,255,.08);border:1px solid var(--border-color);padding:8px 20px;border-radius:50px;cursor:pointer;font-family:'Tajawal',sans-serif;font-size:13px;transition:all var(--transition);color:var(--text-primary)}
        .examples button:hover{background:var(--primary);color:#fff;transform:scale(1.05) translateY(-2px);box-shadow:0 4px 20px var(--primary-glow)}
        .message{padding:16px 24px;border-radius:20px;max-width:min(96%,1100px);word-wrap:break-word;animation:messageSlide .5s cubic-bezier(.34,1.56,.64,1);border:1px solid transparent;box-shadow:0 2px 10px rgba(0,0,0,.04);line-height:1.9;font-size:17px}
        @keyframes messageSlide{from{opacity:0;transform:translateY(15px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
        .message pre{white-space:pre-wrap;font-family:'Tajawal',sans-serif;margin:0;padding:0;direction:rtl;text-align:right;font-size:17px;line-height:2;overflow-wrap:anywhere}
        .message .time{font-size:10px;opacity:.5;display:block;margin-top:8px}
        .message.user{background:var(--bg-message-user);color:#fff;align-self:flex-end;border-bottom-left-radius:6px}
        .message.user pre{color:#fff}
        .message.user .time{color:rgba(255,255,255,.6)}
        .message.ai{background:var(--bg-message-ai);color:var(--text-primary);align-self:flex-start;border-bottom-right-radius:6px;border-color:var(--border-color)}
        .typing{display:none;padding:10px 18px;background:var(--bg-message-ai);border-radius:18px;align-self:flex-start;gap:6px;border:1px solid var(--border-color);border-bottom-right-radius:6px}
        .typing.active{display:flex}
        .typing span{color:var(--text-secondary);font-size:13px}
        .typing .dot{width:8px;height:8px;background:var(--primary);border-radius:50%;animation:typingBounce 1.4s infinite}
        .typing .dot:nth-child(2){animation-delay:.2s}
        .typing .dot:nth-child(3){animation-delay:.4s}
        @keyframes typingBounce{0%,60%,100%{transform:translateY(0)}30%{transform:translateY(-8px)}}
        .input-area{display:flex;gap:10px;padding:14px 20px;border-top:1px solid var(--border-color);flex-shrink:0;background:rgba(0,0,0,.02);align-items:center}
        body.dark-mode .input-area{background:rgba(0,0,0,.15)}
        .input-area textarea{flex:1;padding:12px 18px;border:2px solid var(--border-color);border-radius:16px;font-size:15px;font-family:'Tajawal',sans-serif;resize:none;min-height:48px;max-height:130px;background:var(--bg-input);color:var(--text-primary);line-height:1.6;transition:all var(--transition)}
        .input-area textarea::placeholder{color:var(--text-muted)}
        .input-area textarea:focus{border-color:var(--primary);outline:none;box-shadow:0 0 0 4px var(--primary-glow)}
        .input-area .send-btn{padding:0 28px;border:none;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;font-weight:700;font-size:16px;cursor:pointer;height:48px;font-family:'Tajawal',sans-serif;flex-shrink:0;display:flex;align-items:center;gap:8px;transition:all var(--transition)}
        .input-area .send-btn:hover{transform:translateY(-2px) scale(1.02);box-shadow:0 4px 25px var(--primary-glow)}
        .input-area .send-btn:disabled{opacity:.5;cursor:not-allowed}
        .footer-info{display:flex;justify-content:space-between;padding:8px 20px;font-size:11px;color:var(--text-secondary);border-top:1px solid var(--border-color);flex-shrink:0;background:rgba(0,0,0,.02)}
        body.dark-mode .footer-info{background:rgba(0,0,0,.1)}
        .footer-info .badge{background:rgba(108,99,255,.1);color:var(--primary);padding:2px 14px;border-radius:20px;font-weight:600}
        .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);z-index:1000;justify-content:center;align-items:center;animation:fadeInOverlay .4s ease}
        .overlay.active{display:flex}
        @keyframes fadeInOverlay{from{opacity:0}to{opacity:1}}
        .tafsir-popup{background:var(--bg-chat);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);border-radius:32px;max-width:620px;width:95%;max-height:85vh;padding:32px 28px 28px;box-shadow:0 30px 80px rgba(0,0,0,.5);animation:slideUp .5s cubic-bezier(.34,1.56,.64,1);overflow-y:auto;border:1px solid var(--border-color)}
        @keyframes slideUp{from{transform:translateY(60px) scale(.95);opacity:0}to{transform:translateY(0) scale(1);opacity:1}}
        .tafsir-popup::-webkit-scrollbar{width:5px}
        .tafsir-popup::-webkit-scrollbar-thumb{background:var(--primary);border-radius:10px}
        .popup-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding-bottom:15px;border-bottom:2px solid var(--border-color)}
        .popup-header h3{font-size:22px;font-weight:800;color:var(--text-primary);display:flex;align-items:center;gap:12px}
        .popup-close{background:rgba(108,99,255,.08);border:1px solid var(--border-color);width:42px;height:42px;border-radius:50%;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--text-primary);transition:all var(--transition)}
        .popup-close:hover{background:#ff4757;color:#fff;transform:rotate(90deg) scale(1.05)}
        .popup-verse{background:linear-gradient(135deg,rgba(108,99,255,.08),rgba(108,99,255,.03));border-radius:18px;padding:18px 24px;margin-bottom:20px;text-align:center;font-size:20px;line-height:1.9;color:var(--text-primary);border-right:4px solid var(--primary)}
        .popup-verse .surah-name{display:block;font-size:14px;color:var(--text-secondary);margin-bottom:6px;font-weight:500}
        .popup-verse .verse-text{font-weight:600}
        .popup-subtitle{font-size:15px;color:var(--text-secondary);margin-bottom:16px;display:flex;align-items:center;gap:10px}
        .popup-subtitle .count{background:var(--primary);color:#fff;border-radius:20px;padding:0 14px;font-size:12px;line-height:26px;font-weight:700}
        .tafsir-list{display:flex;flex-direction:column;gap:10px;margin-bottom:20px}
        .tafsir-option{display:flex;align-items:center;gap:14px;padding:14px 18px;border:2px solid var(--border-color);border-radius:16px;cursor:pointer;background:var(--bg-input);position:relative;transition:all var(--transition)}
        .tafsir-option:hover{border-color:var(--primary);transform:translateX(-4px);box-shadow:0 4px 20px rgba(108,99,255,.1)}
        .tafsir-option.selected{border-color:var(--primary);background:rgba(108,99,255,.06);box-shadow:0 4px 25px rgba(108,99,255,.12)}
        .tafsir-option .icon{font-size:28px;flex-shrink:0}
        .tafsir-option .info{flex:1}
        .tafsir-option .info .name{font-weight:600;font-size:16px;color:var(--text-primary)}
        .tafsir-option .info .desc{font-size:12px;color:var(--text-secondary);margin-top:2px}
        .tafsir-option .check{width:26px;height:26px;border-radius:50%;border:2px solid var(--border-color);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px;color:#fff;transition:all var(--transition)}
        .tafsir-option.selected .check{background:var(--primary);border-color:var(--primary)}
        .tafsir-option .color-bar{position:absolute;right:0;top:0;bottom:0;width:5px;border-radius:0 16px 16px 0}
        .popup-actions{display:flex;gap:12px;margin-top:6px;flex-wrap:wrap}
        .popup-actions .btn-primary{flex:1;padding:14px 20px;border:none;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;font-weight:700;font-size:16px;cursor:pointer;font-family:'Tajawal',sans-serif;min-width:120px;transition:all var(--transition)}
        .popup-actions .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 30px var(--primary-glow)}
        .popup-actions .btn-primary:disabled{opacity:.5;cursor:not-allowed}
        .popup-actions .btn-all{flex:1;padding:14px 20px;border:2px solid var(--primary);border-radius:16px;background:transparent;color:var(--primary);font-weight:700;font-size:16px;cursor:pointer;font-family:'Tajawal',sans-serif;min-width:120px;transition:all var(--transition)}
        .popup-actions .btn-all:hover{background:var(--primary);color:#fff;transform:translateY(-2px);box-shadow:0 8px 30px var(--primary-glow)}
        .popup-actions .btn-all.active{background:var(--primary);color:#fff}
        .features-modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);z-index:9999;align-items:center;justify-content:center;padding:20px;animation:fadeInOverlay .4s ease}
        .features-modal-overlay.active{display:flex}
        .features-modal-container{width:min(940px,96vw);max-height:88vh;background:var(--bg-chat);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border:1px solid var(--border-color);border-radius:40px;box-shadow:0 50px 120px rgba(0,0,0,.5);overflow:hidden;animation:slideUp .5s cubic-bezier(.34,1.56,.64,1)}
        .features-modal-header{display:flex;justify-content:space-between;align-items:center;padding:24px 32px;border-bottom:1px solid var(--border-color);background:linear-gradient(135deg,rgba(108,99,255,.06),rgba(255,107,107,.03))}
        .features-modal-title{display:flex;align-items:center;gap:16px}
        .features-modal-icon{font-size:34px;animation:iconPulse 2s infinite}
        .features-modal-title h2{font-size:26px;font-weight:900;background:linear-gradient(135deg,var(--primary),#FF6B6B);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin:0}
        .features-modal-version{font-size:12px;font-weight:700;color:var(--text-secondary);background:rgba(108,99,255,.1);padding:4px 16px;border-radius:20px;border:1px solid var(--border-color)}
        .features-modal-close{width:48px;height:48px;border-radius:50%;border:1px solid var(--border-color);background:var(--bg-input);color:var(--text-primary);font-size:24px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all var(--transition)}
        .features-modal-close:hover{background:#FF6B6B;color:#fff;border-color:#FF6B6B;transform:rotate(90deg) scale(1.05)}
        .features-modal-body{padding:28px 32px;overflow-y:auto;max-height:calc(88vh - 90px)}
        .features-modal-body::-webkit-scrollbar{width:5px}
        .features-modal-body::-webkit-scrollbar-thumb{background:var(--primary);border-radius:10px}
        .features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
        .feature-item{display:flex;align-items:center;gap:14px;padding:16px 20px;border:1px solid var(--border-color);border-radius:20px;background:var(--bg-input);cursor:pointer;position:relative;overflow:hidden;transition:all var(--transition)}
        .feature-item::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(108,99,255,.06),transparent 70%);opacity:0;transition:opacity .4s ease}
        .feature-item:hover::before{opacity:1}
        .feature-item:hover{transform:translateY(-4px) scale(1.02);border-color:var(--primary);box-shadow:0 12px 40px rgba(108,99,255,.12)}
        .feature-item:active{transform:scale(.97)}
        .feature-item-icon{width:50px;height:50px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;flex-shrink:0;box-shadow:0 4px 16px rgba(0,0,0,.1);position:relative;z-index:1}
        .feature-item-content{flex:1;position:relative;z-index:1}
        .feature-item-content h4{font-size:15px;font-weight:700;margin:0 0 2px;color:var(--text-primary)}
        .feature-item-content p{font-size:12px;color:var(--text-secondary);margin:0;line-height:1.4}
        .feature-tag{display:inline-block;font-size:9px;font-weight:700;padding:1px 10px;border-radius:12px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;margin-top:4px;position:absolute;top:8px;left:8px}
