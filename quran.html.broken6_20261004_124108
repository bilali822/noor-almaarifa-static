<script>
// ============================================================
// نور المعرفة - سكربت الشات الكامل
// ============================================================
// إصلاح CSRF: كل طلبات POST من صفحة القرآن تحمل التوكن الموجود في cookie.
(function installQuranCsrfFetch(){
    if (window.__quranCsrfFetchInstalled) return;
    window.__quranCsrfFetchInstalled = true;
    const nativeFetch = window.fetch.bind(window);
    function getCsrfToken(){
        const match = document.cookie.match(/(?:^|;\s*)csrf_token=([^;]+)/);
        return match ? decodeURIComponent(match[1]) : '';
    }
    window.fetch = function(input, init){
        init = init || {};
        const method = String(init.method || 'GET').toUpperCase();
        if (['POST','PUT','PATCH','DELETE'].includes(method)) {
            const headers = new Headers(init.headers || {});
            const token = getCsrfToken();
            if (token) headers.set('X-CSRF-Token', token);
            headers.set('Accept', 'application/json');
            init.headers = headers;
            init.credentials = 'include';
        }
        return nativeFetch(input, init);
    };
})();

let isProcessing = false;
let chatId = 'quran_' + Date.now();
let currentVerseInfo = null;
let selectedTafsirs = new Set();
let currentLimit = 20;

// ---------- الوضع الليلي ----------
function toggleTheme() {
    var body = document.body;
    var btn = document.querySelector('.theme-toggle');
    body.classList.toggle('dark-mode');
    if (btn) btn.textContent = body.classList.contains('dark-mode') ? '☀️' : '🌙';
    try { localStorage.setItem('theme', body.classList.contains('dark-mode') ? 'dark' : 'light'); } catch(e){}
}

function loadTheme() {
    try {
        if (localStorage.getItem('theme') === 'dark') {
            document.body.classList.add('dark-mode');
            var btn = document.querySelector('.theme-toggle');
            if (btn) btn.textContent = '☀️';
        }
    } catch(e){}
}

// ---------- الميزات ----------
function toggleFeaturesModal() {
    var overlay = document.getElementById('featuresModalOverlay');
    if (!overlay) return;
    var isActive = overlay.classList.contains('active');
    overlay.classList.toggle('active');
    document.body.style.overflow = isActive ? '' : 'hidden';
}

function sendExample(text) {
    var inp = document.getElementById('input');
    if (!inp) return;
    inp.value = text;
    sendMessage();
}

// ---------- إضافة رسالة ----------
function escapeHtml(s) {
    return String(s || '').replace(/[&<>"']/g, function(c) {
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];
    });
}

function addMessage(text, type) {
    var container = document.getElementById('messages');
    var welcome = document.getElementById('welcome');
    if (welcome) welcome.style.display = 'none';
    if (!container) return;
    var div = document.createElement('div');
    div.className = 'message ' + type;
    var time = new Date().toLocaleTimeString('ar-SA', {hour: '2-digit', minute: '2-digit'});
    var pre = document.createElement('pre');
    pre.textContent = String(text || '');
    var timeEl = document.createElement('span');
    timeEl.className = 'time';
    timeEl.textContent = time;
    div.appendChild(pre);
    div.appendChild(timeEl);
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

function showTyping(show) {
    var typing = document.getElementById('typing');
    if (typing) typing.classList.toggle('active', !!show);
}

// ---------- القائمة المنبثقة للتفسير ----------
function openPopup(verseInfo, tafsirBooks) {
    currentVerseInfo = verseInfo;
    selectedTafsirs = new Set();
    
    var nameEl = document.getElementById('popupSurahName');
    var textEl = document.getElementById('popupVerseText');
    
    if (nameEl) nameEl.textContent = 'سورة ' + verseInfo.surah_name;
    var verseCount = Array.isArray(verseInfo.verses) ? verseInfo.verses.length : 1;
    if (textEl) textEl.textContent = verseCount > 1 
        ? ('تفسير ' + verseCount + ' آيات') 
        : ('﴿ ' + (verseInfo.verse_text || '') + ' ﴾');
    
    var list = document.getElementById('tafsirList');
    if (!list) return;
    list.innerHTML = '';
    
    (tafsirBooks || []).forEach(function(book) {
        var div = document.createElement('div');
        div.className = 'tafsir-option';
        div.dataset.key = book.key;
        
        var color = book.color || '#6C63FF';
        if (!/^#[0-9a-fA-F]{6}$/.test(color)) color = '#6C63FF';
        
        var hasText = book.text && !book.text.includes('⚠️');
        
        div.innerHTML = '<span class="icon">' + (book.icon || '📖') + '</span>' +
            '<div class="info"><div class="name">' + (book.name || '') + '</div>' +
            '<div class="desc">' + (hasText ? '✅ متوفر' : '⚠️ غير متوفر') + '</div></div>' +
            '<div class="check">✓</div>' +
            '<div class="color-bar" style="background:' + color + '"></div>';
        
        if (!hasText) {
            div.style.opacity = '0.5';
            div.style.cursor = 'not-allowed';
        } else {
            div.addEventListener('click', function() { toggleTafsir(div.dataset.key); });
        }
        list.appendChild(div);
    });
    
    var btn = document.getElementById('btnAllTafsirs');
    if (btn) { btn.classList.remove('active'); btn.textContent = '📚 جميع التفاسير'; }
    updateSelectedCount();
    
    var overlay = document.getElementById('tafsirOverlay');
    if (overlay) overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
}

function closePopup() {
    ['tafsirOverlay','surahOverlay','favoritesOverlay','statsOverlay','booksOverlay'].forEach(function(id){
        var el = document.getElementById(id);
        if (el) el.classList.remove('active');
    });
    document.body.style.overflow = '';
    currentVerseInfo = null;
    selectedTafsirs = new Set();
}

function toggleTafsir(key) {
    if (selectedTafsirs.has(key)) selectedTafsirs.delete(key);
    else selectedTafsirs.add(key);
    updateUI();
}

function selectAllTafsirs() {
    var allKeys = document.querySelectorAll('.tafsir-option:not([style*="opacity: 0.5"])');
    var btn = document.getElementById('btnAllTafsirs');
    if (selectedTafsirs.size === allKeys.length && allKeys.length > 0) {
        selectedTafsirs = new Set();
        if (btn) { btn.classList.remove('active'); btn.textContent = '📚 جميع التفاسير'; }
    } else {
        selectedTafsirs = new Set();
        allKeys.forEach(function(el) { selectedTafsirs.add(el.dataset.key); });
        if (btn) { btn.classList.add('active'); btn.textContent = '📚 إلغاء الكل'; }
    }
    updateUI();
}

function updateUI() {
    document.querySelectorAll('.tafsir-option').forEach(function(el){
        el.classList.toggle('selected', selectedTafsirs.has(el.dataset.key));
    });
    updateSelectedCount();
}

function updateSelectedCount() {
    var el = document.getElementById('selectedCount');
    if (el) el.textContent = selectedTafsirs.size;
}

async function showSelectedTafsirs() {
    if (selectedTafsirs.size === 0) {
        alert('⚠️ اختر تفسيراً واحداً على الأقل');
        return;
    }
    
    var btn = document.getElementById('btnShowTafsir');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ جاري التحميل...'; }
    
    try {
        var selected = Array.from(selectedTafsirs);
        var verses = (currentVerseInfo.verses && currentVerseInfo.verses.length) 
            ? currentVerseInfo.verses 
            : [currentVerseInfo];
        
        var responseParts = [];
        
        for (var i = 0; i < verses.length; i++) {
            var v = verses[i];
            var sid = v.surah_id || currentVerseInfo.surah_id;
            var vn = v.verse_number;
            var sn = v.surah_name || currentVerseInfo.surah_name;
            var vt = v.verse_text || '';
            
            responseParts.push('📖 سورة ' + sn + ' — الآية ' + vn);
            responseParts.push('﴿ ' + vt + ' ﴾');
            responseParts.push('');
            
            for (var j = 0; j < selected.length; j++) {
                var key = selected[j];
                try {
                    var tafsirText = await window.NoorDB.getTafsir(key, sid, vn);
                    var book = await window.NoorDB.getTafsirBook(key);
                    
                    if (tafsirText && !tafsirText.startsWith('⚠️')) {
                        responseParts.push((book?.icon || '📖') + ' تفسير ' + (book?.short_name || key) + ':');
                        responseParts.push(tafsirText);
                        responseParts.push('');
                    }
                } catch (e) {
                    console.warn('فشل تفسير ' + key, e);
                }
            }
            responseParts.push('─────────────────');
            responseParts.push('');
        }
        
        responseParts.push('ملاحظة: من كتب التفسير المعتمدة عند أهل السنة والجماعة');
        
        addMessage(responseParts.join('\n'), 'ai');
        closePopup();
    } catch(err) {
        alert('❌ خطأ: ' + err.message);
    } finally {
        if (btn) { btn.disabled = false; btn.textContent = '✅ عرض التفسير'; }
    }
}

// ---------- إرسال الرسائل ----------
async function sendMessage() {
    var input = document.getElementById('input');
    if (!input) return;
    var text = input.value.trim();
    if (!text || isProcessing) return;
    
    addMessage(text, 'user');
    input.value = '';
    isProcessing = true;
    
    var btn = document.getElementById('sendBtn');
    if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
    showTyping(true);

    try {
        // ✅ استخدام البحث المحلي مباشرة
        var result = await window.QuranSearchEngine.search(text, window.NoorDB);
        
        showTyping(false);
        
        if (result.success && result.type === 'verse') {
            try { localStorage.setItem('lastRead', JSON.stringify(result.data)); } catch(e){}
            openPopup(result.data, result.data.tafsir_books);
        } else if (result.success && result.type === 'surah') {
            var verses = result.data.verses || [];
            var msg = '📖 سورة ' + result.data.surah_name + ' (' + result.data.verse_count + ' آية)\n;
            verses.slice(0, 20).forEach(function(v) {
                msg += v.verse_number + '. ﴿ ' + v.verse_text + ' ﴾\n;
            });
            if (verses.length > 20) msg += '
... و ' + (verses.length - 20) + ' آية أخرى';
            addMessage(msg, 'ai');
            if (verses.length > 0 && result.data.tafsir_books && result.data.tafsir_books.length > 0) {
                openPopup(result.data, result.data.tafsir_books);
            }
        } else if (result.success && result.type === 'range') {
            var verses2 = result.data.verses || [];
            var msg2 = '📖 سورة ' + result.data.surah_name + ' (' + result.data.start_verse + '-' + result.data.end_verse + ')\n;
            verses2.forEach(function(v){ msg2 += v.verse_number + '. ﴿ ' + v.verse_text + ' ﴾\n; });
            addMessage(msg2, 'ai');
            if (verses2.length > 0 && result.data.tafsir_books) {
                openPopup(result.data, result.data.tafsir_books);
            }
        } else if (result.success && result.type === 'search') {
            var results = result.data.results || [];
            var msg3 = '🔍 نتائج البحث (' + results.length + '):\n;
            results.slice(0, 10).forEach(function(r, i) {
                msg3 += (i+1) + '. ' + r.surah_name + ' ' + r.verse_number + ': ﴿ ' + r.verse_text.substring(0, 100) + '... ﴾\n;
            });
            addMessage(msg3, 'ai');
        } else {
            addMessage(result.reply || '❌ لم أجد نتيجة', 'ai');
        }
    } catch(err) {
        showTyping(false);
        console.error('[Chat] خطأ:', err);
        addMessage('❌ خطأ: ' + err.message, 'ai');
    } finally {
        if (btn) { btn.disabled = false; btn.textContent = 'إرسال ➤'; }
        if (input) input.focus();
        isProcessing = false;
    }
}

// ---------- الميزات الأخرى ----------
