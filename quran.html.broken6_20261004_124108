<script>
(function() {
  'use strict';
  const NAME_KEY = 'noor_user_name';
  const GENDER_KEY = 'noor_user_gender';
  let selectedGender = null;
  
  // ═══════════════════════════════════════════════════
  // تخزين
  // ═══════════════════════════════════════════════════
  function getName() {
    try { return localStorage.getItem(NAME_KEY) || ''; } catch(e) { return ''; }
  }
  function getGender() {
    try { return localStorage.getItem(GENDER_KEY) || 'male'; } catch(e) { return 'male'; }
  }
  function save(name, gender) {
    try {
      localStorage.setItem(NAME_KEY, name);
      localStorage.setItem(GENDER_KEY, gender);
    } catch(e) {}
  }
  
  // ═══════════════════════════════════════════════════
  // نصوص حسب الجنس
  // ═══════════════════════════════════════════════════
  function getGreeting(name, gender) {
    if (gender === 'female') {
      return 'حيّاكِ الله يا ' + name;
    }
    return 'حيّاك الله يا ' + name;
  }
  
  function getChatGreeting(name, gender) {
    if (gender === 'female') {
      return 'حيّاكِ الله يا ' + name + ' في نور المعرفة';
    }
    return 'حيّاك الله يا ' + name + ' في نور المعرفة';
  }
  
  function getBadgeIcon(gender) {
    return gender === 'female' ? '🌸' : '🕌';
  }
  
  // ═══════════════════════════════════════════════════
  // إظهار/إخفاء
  // ═══════════════════════════════════════════════════
  function show() {
    const o = document.getElementById('nmNameOverlay');
    if (!o) return;
    o.classList.add('nm-visible');
    o.style.display = 'flex';
    setTimeout(() => {
      const i = document.getElementById('nmNameInput');
      if (i) { i.focus(); try { i.select(); } catch(e) {} }
    }, 400);
  }
  
  function hide() {
    const o = document.getElementById('nmNameOverlay');
    if (!o) return;
    o.classList.remove('nm-visible');
    o.style.display = 'none';
  }
  
  // ═══════════════════════════════════════════════════
  // تطبيق النصوص حسب الجنس
  // ═══════════════════════════════════════════════════
  function applyName(name, gender) {
    if (!name) return;
    
    // الصفحة الرئيسية
    const h1 = document.querySelector('.welcome-section h1');
    if (h1) h1.textContent = getGreeting(name, gender);
    
    // صفحة الشات
    const chatH2 = document.querySelector('.welcome h2');
    if (chatH2) chatH2.textContent = getChatGreeting(name, gender);
    
    // بادج الاسم
    const header = document.querySelector('.header');
    if (header && !document.getElementById('nmUserNameBadge')) {
      const b = document.createElement('div');
      b.id = 'nmUserNameBadge';
      b.style.cssText = 'display:flex;align-items:center;gap:8px;background:linear-gradient(135deg,#6C63FF,#5A4FCF);color:white;padding:8px 16px;border-radius:20px;font-weight:700;font-size:14px;font-family:Tajawal,system-ui,sans-serif;cursor:pointer;box-shadow:0 4px 15px rgba(108,99,255,.3);margin-inline-start:10px;flex-shrink:0;';
      b.onclick = function() {
        const x = prompt('✏️ تغيير الاسم:', getName());
        if (x && x.trim()) {
          save(x.trim(), getGender());
          location.reload();
        }
      };
      b.innerHTML = '<span>' + getBadgeIcon(gender) + '</span><span>' + name + '</span>';
      
      const target = header.querySelector('.header-left') 
                  || header.querySelector('.header-right') 
                  || header;
      target.appendChild(b);
    }
  }
  
  // ═══════════════════════════════════════════════════
  // تشغيل
  // ═══════════════════════════════════════════════════
  function init() {
    console.log('[Name] init');
    const name = getName();
    const gender = getGender();
    
    if (name) {
      console.log('[Name] محفوظ:', name, '/', gender);
      applyName(name, gender);
      hide();
    } else {
      console.log('[Name] لا يوجد — عرض النافذة');
      show();
    }
    
    const btn = document.getElementById('nmNameBtn');
    const input = document.getElementById('nmNameInput');
    const genderBtns = document.querySelectorAll('.nm-gender-btn');
    
    // اختيار الجنس
    genderBtns.forEach(function(gb) {
      gb.onclick = function() {
        genderBtns.forEach(function(b) { b.classList.remove('nm-gender-active'); });
        gb.classList.add('nm-gender-active');
        selectedGender = gb.dataset.gender;
        console.log('[Name] جنس:', selectedGender);
        
        // فعّل زر المتابعة إذا الاسم موجود
        if (input && input.value.trim().length >= 2) {
          btn.disabled = false;
        }
      };
    });
    
    // زر المتابعة
    if (btn && input) {
      btn.onclick = function() {
        const v = input.value.trim();
        
        if (!v || v.length < 2) {
          input.style.borderColor = '#FF4757';
          input.focus();
          input.placeholder = '⚠️ اكتب اسمك (حرفان على الأقل)';
          return;
        }
        
        if (!selectedGender) {
          alert('👤 الرجاء اختيار الجنس');
          return;
        }
        
        console.log('[Name] حفظ:', v, '/', selectedGender);
        save(v, selectedGender);
        hide();
        applyName(v, selectedGender);
      };
      
      // Enter
      input.onkeydown = function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          btn.click();
        }
      };
      
      // تمكين الزر عند الكتابة + الجنس مختار
      input.oninput = function() {
        input.style.borderColor = '#e5e5f0';
        if (input.value.trim().length >= 2 && selectedGender) {
          btn.disabled = false;
        } else {
          btn.disabled = true;
        }
      };
    } else {
      console.warn('[Name] btn/input not found');
    }
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  
  window.addEventListener('load', function() {
    const o = document.getElementById('nmNameOverlay');
    if (o && o.style.display !== 'flex' && !getName()) {
      show();
    }
  });
  
  window.NoorUserName = {
    get: getName,
    getGender: getGender,
    set: save,
    show: show,
    hide: hide
  };
  console.log('[Name] ✅ جاهز');
})();
</script>
