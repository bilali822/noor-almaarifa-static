(function exposeGlobals() {
    [
        'toggleTheme','loadTheme','sendExample','toggleFeaturesModal','openPopup','closePopup',
        'openSurahIndex','openSurahById','filterSurahs','openQuranSearch','loadRandomVerse','showVerseFeature',
        'saveCurrentVerse','openFavorites','openFavorite','removeFavorite','resumeLastRead','changeFontSize',
        'loadFontSize','copyCurrentVerse','shareCurrentVerse','showCurrentSurah','showSurahStats','navigateVerse',
        'toggleReadingMode','openTafsirLibrary','clearChat','selectAllTafsirs','showSelectedTafsirs',
        'toggleTafsir','updateUI','updateSelectedCount','sendMessage','addMessage','showTyping','escapeHtml'
    ].forEach(function(name){
        if (typeof window[name] !== 'function' && typeof globalThis[name] === 'function') {
            window[name] = globalThis[name];
        }
    });
})();

