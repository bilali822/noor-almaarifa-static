// 🔧 FIX: ربط الأزرار بـ addEventListener كحل احتياطي
// ═══════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', function() {
    // ربط أزرار الأمثلة
    document.querySelectorAll('.examples button').forEach(function(btn) {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        var onclickAttr = btn.getAttribute('onclick') || '';
        var match = onclickAttr.match(/sendExample\(['"](.+?)['"]\)/);
        if (match) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                sendExample(match[1]);
            });
        }
    });

    // أزرار الميزات تستخدم onclick مع الدوال المكشوفة عالمياً.

    // ربط أزرار إغلاق المودالات
    document.querySelectorAll('.popup-close, .features-modal-close').forEach(function(btn) {
        if (btn.dataset.bound === '1') return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            if (typeof closePopup === 'function') closePopup();
            var fm = document.getElementById('featuresModalOverlay');
            if (fm) {
                fm.classList.remove('active');
                document.body.style.overflow = '';
            }
        });
    });

    console.log('✅ تم ربط كل الأزرار بنجاح');
});
</script>
